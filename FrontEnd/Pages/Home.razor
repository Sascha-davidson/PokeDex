@page "/"
@inject PokeApiClient Api

<h1>Pokédex</h1>

@if (_pokemonDetails is null)
{
    <p>Loading…</p>
}
else
{
    <div class="pokemon-grid">
        @foreach (var p in _pokemonDetails)
        {
            <div class="pokemon-card">
                <img src="@p.ImageUrl" alt="@p.Name" />
                <h3>@p.Id. @p.Name</h3>
                <p>Type: @string.Join(", ", p.Types)</p>
            </div>
        }
    </div>

    <button class="load-more-btn" @onclick="LoadMore" disabled="@_loadingMore">
        @_loadingMore ? "Loading…" : "Load More"
    </button>
}

@code {
    private List<PokemonDetailViewModel> _pokemonDetails = new();
    private int _offset = 0;            // Tracks how many we've loaded
    private const int _pageSize = 100;  // Load 100 at a time
    private bool _loadingMore = false;  // Prevent double-click

    protected override async Task OnInitializedAsync()
    {
        await LoadPokemonBatch();
    }

    private async Task LoadMore()
    {
        await LoadPokemonBatch();
    }

    private async Task LoadPokemonBatch()
    {
        _loadingMore = true;

        // Fetch next batch
        var list = await Api.GetPokemonListAsync(_pageSize, _offset);

        // Fetch details concurrently
        var tasks = list.Results.Select(async item =>
        {
            var details = await Api.GetPokemonAsync(item.Name);
            return new PokemonDetailViewModel
            {
                Id = details.Id,
                Name = details.Name,
                ImageUrl = details.Sprites.Other?.OfficialArtwork.FrontDefault ?? details.Sprites.Front_Default,
                Types = details.Types.Select(t => t.Type.Name).ToList()
            };
        });

        _pokemonDetails.AddRange(await Task.WhenAll(tasks));

        // Update offset for next batch
        _offset += _pageSize;
        _loadingMore = false;
    }

    public class PokemonDetailViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public List<string> Types { get; set; } = new();
    }
}
