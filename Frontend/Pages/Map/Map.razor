@page "/Map/{Generation:int}/{Game:int}"
@layout MapLayout
@inject IJSRuntime JsRuntime
@inject HttpClient Http

@if (_maps is null)
{
    <p>Loading map data...</p>
}
else
{
    <div @ref="_mapElement" class="map"></div>
}

@code {
    [Parameter]
    public int Generation { get; set; }

    [Parameter]
    public int Game { get; set; }

    [SupplyParameterFromQuery]
    private string? Version { get; set; }

    private PokemonMaps _maps;

    private ElementReference _mapElement;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        var generation = await Http.GetFromJsonAsync<PokemonGeneration>(
            $"api/pokemon-generation/{Generation}");
        
        if (generation is null)
            return;

        var game = await Http.GetFromJsonAsync<PokemonGame>(
            $"api/pokemon-game/{Game}");

        if (game is null || game.GenerationId != generation.Id)
            return;

        var maps = await Http.GetFromJsonAsync<List<PokemonMaps>>(
            $"api/pokemon-map/{generation.Id}/{game.Id}");

        _maps = maps?.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is not null || _maps is null)
            return;

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./Pages/Map/Map.razor.js");

        await _module.InvokeVoidAsync(
            "initialize",
            _mapElement,
            _maps.SvgPath);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}