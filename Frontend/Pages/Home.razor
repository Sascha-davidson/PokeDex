@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<h1>Discover the World of <span class="gradient-text">Pokémon</span></h1>
<h2>Pokédex</h2>

@if (pokemon is null)
{
    <p>Loading…</p>
}
else
{
    <div class="pokemon-grid">
        @foreach (var p in pokemon)
        {
            <div class="pokemon-card">
                <img src="@p.ImageUrl" class="@(fallbackImageIds.Contains(p.Id) ? "fallback" : null)" @onerror="@(() => HandleImageError(p))" alt="@p.Name" />
                <div class="card-details">
                    <h3>@p.Id. @p.Name</h3>
                    <p>Type: @string.Join(", ", p.Types)</p>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PokemonDto>? pokemon;
    private readonly HashSet<int> fallbackImageIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPokemonBatch();
    }

    private async Task LoadPokemonBatch()
    {
        pokemon = await Http.GetFromJsonAsync<List<PokemonDto>>("api/pokemon");
    }

    private void HandleImageError(PokemonDto p)
    {
        p.ImageUrl = "/Image/fallback.png";
        fallbackImageIds.Add(p.Id);
    }
}
