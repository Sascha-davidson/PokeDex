@page "/PokeDex"
@using PokeDex.FrontEnd.Services
@inject PokeApiClient PokeApi

<h1>Discover the World of <span class="gradient-text">Pokémon</span></h1>
<h2>Pokédex</h2>

@if (pokemon is null)
{
    <p>Loading…</p>
}
else
{
    <div class="pokemon-grid">
        @foreach (var p in pokemon)
        {
            <div class="pokemon-card">
                <img src="@p.ImageUrl" alt="@p.Name" />
                <div class="card-details">
                    <h3>@p.Id. @p.Name</h3>
                    <p>Type: @string.Join(", ", p.Types)</p>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PokemonDto>? pokemon;

    protected override async Task OnInitializedAsync()
    {
        await LoadPokemonBatch();
    }

    private async Task LoadPokemonBatch()
    {
        var list = await PokeApi.GetPokemonListAsync(20, 0);

        var details = await Task.WhenAll(
            list.Results.Select(item => PokeApi.GetPokemonAsync(item.Name)));

        pokemon = details
            .Select(d => new PokemonDto
            {
                Id = d.Id,
                Name = d.Name,
                ImageUrl = d.Sprites.Other?.OfficialArtwork?.FrontDefault ?? d.Sprites.Front_Default ?? string.Empty,
                Types = d.Types.Select(t => t.Type.Name).ToList()
            })
            .ToList();
    }
}
